# Benchmark config. Copy to `bench/.env` (gitignored) and fill in real values.
#
#   make bench                 # BENCH_TARGET=docker (default) — NO .env needed
#
# docker mode is fully self-contained (local MinIO + Iceberg REST + Exasol, TPC-H
# loaded locally) and needs none of the values below. Only remote mode requires
# .env. Env-var names mirror crates/lakehouse-engine/tests/cloud_e2e_test.rs.

# Target: `docker` (self-contained local stack) or `remote` (AWS Glue + your cluster).
BENCH_TARGET=docker

# --- docker mode (optional) ---
TPCH_SCALE=0.3                             # TPC-H scale factor (~300MB); <500MB keeps transport fast
TPCH_FILES=4                               # # Parquet files for big tables (lineitem/orders) -> shard fan-out
LH_EXASOL_CPUS=4                           # CPUs given to the Exasol container
BENCH_NR_OF_CORES=4                        # NR_OF_CORES VS prop (drives DataFusion partitions/threads defaults)
BENCH_PARALLELISM_FACTOR=8                 # PARALLELISM_FACTOR VS prop (shard oversubscription)

# --- remote mode only: AWS Glue Iceberg REST catalog + S3 ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=                       # optional (STS)
GLUE_CATALOG_URI=https://glue.us-east-1.amazonaws.com/iceberg
GLUE_WAREHOUSE=s3://your-bucket/warehouse/
ICEBERG_NAMESPACE=tpch                     # namespace holding the 8 TPC-H tables

# --- remote mode only: external Exasol cluster ---
EXASOL_HOST=
LH_EXASOL_PORT=28563
LH_BUCKETFS_PORT=22581
EXASOL_SYS_PASSWORD=
BUCKETFS_WRITE_PASS=                       # remote: no docker-exec auto-discovery
# BENCH_PROFILE=1                          # remote: 1 = best-effort Exasol PROFILE dump (default 1)
