# Benchmark config. Copy to `bench/.env` (gitignored) and fill in real values.
#
#   make bench                 # BENCH_TARGET=docker (default) — NO .env needed
#
# docker mode is fully self-contained (local MinIO + Iceberg REST + Exasol, TPC-H
# loaded locally) and needs none of the values below. Only remote mode requires
# .env. Env-var names mirror crates/lakehouse-engine/tests/cloud_e2e_test.rs.

# Target: `docker` (self-contained local stack) or `remote` (AWS Glue + your cluster).
BENCH_TARGET=docker

# --- docker mode (optional) ---
TPCH_SCALE=0.3                             # TPC-H scale factor (~300MB); <500MB keeps transport fast
TPCH_FILES=4                               # # Parquet files for big tables (lineitem/orders) -> shard fan-out
LH_EXASOL_CPUS=4                           # CPUs given to the Exasol container
BENCH_NR_OF_CORES=4                        # NR_OF_CORES VS prop (drives DataFusion partitions/threads defaults)
BENCH_PARALLELISM_FACTOR=8                 # PARALLELISM_FACTOR VS prop (shard oversubscription)

# BENCH_NR_OF_CORES and BENCH_PARALLELISM_FACTOR (defined under docker mode above)
# also apply in remote mode — they are wired into NR_OF_CORES / PARALLELISM_FACTOR
# VS properties for both targets.  Override here for the live cluster, e.g.:
# BENCH_NR_OF_CORES=8
# BENCH_PARALLELISM_FACTOR=8

# --- delete-bearing benchmark (Iceberg v2 merge-on-read position deletes) ---
BENCH_WITH_DELETES=0                       # 1 = run suite against delete-bearing tables; 0 = OFF, byte-for-byte unchanged
# BENCH_DELETE_NAMESPACE=                  # default ${NAMESPACE}_deletes (docker) / tpch_deletes (remote); override to point elsewhere
# ON needs a one-time authoring step first: docker does it automatically (bench/make_deletes_docker.sh, idempotent);
# remote requires running deploy/scripts/make_deletes_remote.py once beforehand, else run.sh errors clearly.
# BENCH_WITH_DELETES also gates the 4 competitor scripts below (athena_compare.sh /
# trino_compare.sh / import_jdbc_trino.sh / spark_compare.sh) — each resolves its own
# override var (ATHENA_DATABASE / TRINO_SCHEMA / SPARK_NAMESPACE) to "tpch_deletes" when
# unset and the flag is on, reading the SAME Glue database make-deletes-remote.sh authors.

# --- which config file run.sh reads (set in the ENVIRONMENT, never in this file) ---
# BENCH_ENV_FILE=bench/.env                # default; point it elsewhere to run against another
#                                            environment without moving bench/.env aside. Set it to
#                                            a non-file (BENCH_ENV_FILE=/dev/null) to read NO config
#                                            at all — that is how `./bench/run.sh selftest` stays
#                                            offline on a machine that has a real remote .env.
#                                            Setting it INSIDE this file has no effect: the file it
#                                            names has already been chosen by the time it is sourced.

# --- remote mode only: which catalog backs the CONNECTION ---
# BENCH_CATALOG=glue                       # 'glue' (default) or 'lakekeeper'; unknown value = hard error.
                                            # Selects catalog auth only — data, namespace, warehouse
                                            # naming, and query set are identical either way.

# --- remote mode only: AWS Glue Iceberg REST catalog + S3 ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=                       # optional (STS)
GLUE_CATALOG_URI=https://glue.us-east-1.amazonaws.com/iceberg
GLUE_WAREHOUSE=123456789012                # Glue catalog id (account id), NOT an s3:// path
NAMESPACE=tpch                             # namespace holding the 8 TPC-H tables
# AWS_S3_ENDPOINT=                         # S3 data endpoint; default https://s3.$AWS_REGION.amazonaws.com

# --- remote mode only, BENCH_CATALOG=lakekeeper: opt-in ephemeral Lakekeeper catalog ---
# Written automatically by deploy/scripts/secrets.sh <env> once deploy/scripts/lakekeeper-up.sh
# <env> has applied a Lakekeeper stack workspace for that environment — see deploy/README.md's
# "Lakekeeper (ephemeral, opt-in)" section. Reuses the same AWS_REGION / AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY above (the read-only engine-reader key pair) for the S3 data path;
# authentication to the catalog itself is OAuth2 client-credentials, not SigV4.
# LAKEKEEPER_CATALOG_URI=                  # e.g. http://<lakekeeper-host>:8181/catalog
# LAKEKEEPER_WAREHOUSE=                    # a NAME, like GLUE_WAREHOUSE above — NOT an s3:// path
                                            # or an endpoint; the adapter resolves the actual storage
                                            # location from Lakekeeper's own config response
# LAKEKEEPER_CLIENT_ID=                    # Keycloak OAuth2 client id (realm: iceberg)
# LAKEKEEPER_CLIENT_SECRET=                # Keycloak OAuth2 client secret
# LAKEKEEPER_TOKEN_URI=                    # e.g. http://<lakekeeper-host>:8080/realms/iceberg/protocol/openid-connect/token

# --- remote mode only: external Exasol cluster ---
EXASOL_HOST=
LH_EXASOL_PORT=28563
LH_BUCKETFS_PORT=22581
EXASOL_SYS_PASSWORD=
BUCKETFS_WRITE_PASS=                       # remote: no docker-exec auto-discovery
# BENCH_PROFILE=1                          # remote: 1 = best-effort Exasol PROFILE dump (default 1)

# --- competitive engine comparison (athena_compare.sh / trino_compare.sh / spark_compare.sh) ---
# ATHENA_WORKGROUP=                        # deploy/data-stack: tofu output -raw athena_workgroup
# ATHENA_DATABASE=tpch                     # override; default tpch / tpch_deletes (BENCH_WITH_DELETES=1)
# TRINO_HOST=                              # deploy/scripts/trino-up.sh <env> prints this; unset = SKIP
# TRINO_PORT=8080
# TRINO_SCHEMA=tpch                        # override (trino_compare.sh + import_jdbc_trino.sh); default tpch / tpch_deletes (BENCH_WITH_DELETES=1)
# EMR_SERVERLESS_APP_ID=                   # data-stack (enable_emr_serverless=true): tofu output -raw emr_serverless_app_id; unset = SKIP
# EMR_SERVERLESS_ROLE_ARN=                 # tofu output -raw emr_serverless_job_role_arn
# SPARK_SCRIPT_S3_URI=                     # tofu output -raw spark_script_s3_uri
# SPARK_LOG_S3_URI=                        # tofu output -raw emr_serverless_log_uri
# SPARK_NAMESPACE=tpch                     # override; default tpch / tpch_deletes (BENCH_WITH_DELETES=1)

# --- pre-staged BucketFS artifacts (when you can't let the bench PUT them, e.g.
#     BucketFS write is blocked and you uploaded the .so + SLC via AdminUI) ---
# BENCH_SKIP_UPLOAD=1                                              # skip the SLC + .so PUTs; just register alias + build VS
# BENCH_SO_UDF_OBJECT=buckets/bfsdefault/default/liblakehouse_engine.so   # where the .so actually sits (%udf_object path)
# BENCH_SLC_BUCKET_PATH=bfsdefault/default/lc-rust-0.16.0         # extracted SLC dir (a foo.tar.gz upload extracts to foo)
