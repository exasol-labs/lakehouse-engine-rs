# OpenTofu working dirs + state (lock files .terraform.lock.hcl ARE tracked)
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# Backend config (bucket/key/region) is env-specific and identifies the AWS account — never commit
# the real values, only the .example placeholder.
backend.hcl
!backend.hcl.example
crash.log

# python
**/__pycache__/
*.pyc

# local c4 binary cache
.c4/

# c4-downloaded Exasol package tarballs
exasol-*.tar.gz
