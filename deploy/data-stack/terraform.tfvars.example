# Copy to terraform.tfvars (gitignored) to match this stack's actual applied state.
# Without this pinned, a bare `tofu plan`/`apply` defaults enable_emr_serverless=false and
# will offer to DESTROY the live EMR Serverless application (used by spark_compare.sh and
# make-deletes-remote.sh) — found live-verifying after re-pointing tofu at existing state.
enable_emr_serverless = true
