#!/usr/bin/env bash
# Trino bootstrap: installs Docker, writes a single-node Trino config (coordinator + worker in one
# JVM — this is a benchmark box, not production), points the Iceberg connector at the SAME Glue
# catalog + S3 warehouse the lakehouse engine and Athena already query, and runs the pinned Trino
# image. AWS creds come from the instance profile (IMDS) — no static keys on the box.
set -uo pipefail
exec > >(tee /var/log/trino-userdata.log) 2>&1

export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get install -y -qq docker.io
systemctl enable --now docker

mkdir -p /opt/trino/etc/catalog /opt/trino/data
# The official image runs Trino as uid/gid 1000; a root-owned bind mount makes it fail with
# "Permission denied: '/data/trino/var'" on startup (found live-verifying against test1).
chown -R 1000:1000 /opt/trino/data

cat >/opt/trino/etc/node.properties <<EOF
node.environment=benchmark
node.data-dir=/data/trino
EOF

# r6i.xlarge = 30 GiB RAM; 24G heap leaves headroom for the OS/JVM overhead outside -Xmx. The
# 3-way customer-orders-lineitem join (Q2) over 180M lineitem rows OOMs Trino's default per-node
# query memory limit on a single node — found live-verifying against test1 (180M-row lineitem) —
# so query.max-memory-per-node is raised to fit under the bumped heap.
cat >/opt/trino/etc/jvm.config <<'EOF'
-server
-Xmx24G
-XX:+UseG1GC
-XX:G1HeapRegionSize=32M
-XX:+ExplicitGCInvokesConcurrent
-XX:+ExitOnOutOfMemoryError
-Djdk.attach.allowAttachSelf=true
EOF

cat >/opt/trino/etc/config.properties <<'EOF'
coordinator=true
node-scheduler.include-coordinator=true
http-server.http.port=8080
discovery.uri=http://localhost:8080
query.max-memory-per-node=18GB
query.max-memory=18GB
memory.heap-headroom-per-node=4GB
EOF

# Glue IS the catalog here (not a generic REST endpoint), so iceberg.catalog.type=glue talks to it
# directly via the AWS SDK — no REST/SigV4 config needed at all. (Trino 465's Iceberg REST
# connector only supports NONE/OAUTH2 for iceberg.rest-catalog.security; SIGV4 is not a valid value
# there — found live-verifying against test1.) Credentials/region resolve via the default AWS SDK
# chain, which the instance profile supplies.
cat >/opt/trino/etc/catalog/iceberg.properties <<EOF
connector.name=iceberg
iceberg.catalog.type=glue
hive.metastore.glue.region=${region}
fs.native-s3.enabled=true
s3.region=${region}
EOF

docker run -d --name trino --restart unless-stopped \
  --network host \
  -e AWS_REGION=${region} \
  -v /opt/trino/etc:/etc/trino \
  -v /opt/trino/data:/data/trino \
  ${trino_image}

echo "==> Trino container started; waiting for /v1/info"
for _ in $(seq 1 60); do curl -sf http://localhost:8080/v1/info >/dev/null && break; sleep 5; done
echo "==> done"
