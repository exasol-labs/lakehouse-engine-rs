# Azure E2E suite config. Copy to `test.env` (gitignored) and fill in real
# values, then run `make test-e2e-azure`. See
# specs/e2e-harness/azure-e2e-harness/spec.md for details. All five variables
# are required; the suite fails loud (never skips) when one is missing.

# --- Data path (under test): the CONNECTION's static account-key credential ---
AZURE_STORAGE_ACCOUNT_NAME=placeholder
AZURE_STORAGE_ACCOUNT_KEY=placeholder

# --- Container lifecycle (harness only): Entra ID service principal used to
#     create/delete the per-run test container. Never reaches the CONNECTION
#     under test. Needs the Storage Blob Data Contributor role. ---
AZURE_TENANT_ID=placeholder
AZURE_CLIENT_ID=placeholder
AZURE_CLIENT_SECRET=placeholder
