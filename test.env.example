# Azure E2E suite config. Copy to `test.env` (gitignored) and fill in real
# values, then run `make test-e2e-azure`. All five variables are required;
# the suite fails loud (never skips) when one is missing.

# --- Data path: reaches the CONNECTION under test ---
AZURE_STORAGE_ACCOUNT_NAME=placeholder
AZURE_STORAGE_ACCOUNT_KEY=placeholder

# --- Container lifecycle only (harness, never reaches the CONNECTION): Entra ID
#     service principal with Storage Blob Data Contributor ---
AZURE_TENANT_ID=placeholder
AZURE_CLIENT_ID=placeholder
AZURE_CLIENT_SECRET=placeholder
