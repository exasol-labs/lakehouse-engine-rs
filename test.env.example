# Azure and Glue E2E suite config. Copy to `test.env` (gitignored) and fill in real
# values, then run `make test-e2e-azure` or `make test-e2e-glue`. Every variable of the
# suite you run is required; each suite fails loud (never skips) when one is missing.

# --- Data path: reaches the CONNECTION under test ---
AZURE_STORAGE_ACCOUNT_NAME=placeholder
AZURE_STORAGE_ACCOUNT_KEY=placeholder

# --- Container lifecycle only (harness, never reaches the CONNECTION): Entra ID
#     service principal with Storage Blob Data Contributor ---
AZURE_TENANT_ID=placeholder
AZURE_CLIENT_ID=placeholder
AZURE_CLIENT_SECRET=placeholder

# --- Glue E2E ---
# The IAM key needs a policy scoped to the Glue databases lh_e2e_* and the prefix lh_e2e/ of
# GLUE_FIXTURE_BUCKET, granting glue:CreateDatabase, glue:DeleteDatabase, glue:GetDatabase,
# glue:GetDatabases, glue:CreateTable, glue:DeleteTable, glue:GetTable, glue:GetTables,
# glue:BatchCreatePartition, glue:GetPartitions, s3:ListBucket, s3:GetObject, s3:PutObject,
# and s3:DeleteObject.
GLUE_ACCESS_KEY_ID=placeholder
GLUE_SECRET_ACCESS_KEY=placeholder
GLUE_REGION=placeholder
GLUE_FIXTURE_BUCKET=placeholder

# --- Glue E2E: assume-role CONNECTION ---
# A base IAM user whose only permission is sts:AssumeRole on GLUE_ASSUME_ROLE_ARN. The role's trust
# policy names that user and requires GLUE_ASSUME_ROLE_EXTERNAL_ID. Its permissions grant
# glue:GetDatabase, glue:GetDatabases, glue:GetTable, glue:GetTables, and glue:GetPartitions on the
# Glue databases lh_e2e_*, and s3:ListBucket and s3:GetObject on the prefix lh_e2e/ of
# GLUE_FIXTURE_BUCKET.
GLUE_ASSUME_ROLE_BASE_ACCESS_KEY_ID=placeholder
GLUE_ASSUME_ROLE_BASE_SECRET_ACCESS_KEY=placeholder
GLUE_ASSUME_ROLE_ARN=placeholder
GLUE_ASSUME_ROLE_EXTERNAL_ID=placeholder
